[Unit]
Description=RAV Spy Laptop Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rav
WorkingDirectory=/home/rav/Development/RAV-SPY
ExecStart=/home/rav/Development/RAV-SPY/deploy/start-agent.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
