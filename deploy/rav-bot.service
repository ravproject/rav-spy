[Unit]
Description=RAV Spy Telegram Bot
After=network-online.target rav-spy-agent.service
Wants=network-online.target
BindsTo=rav-spy-agent.service

[Service]
Type=simple
User=rav
WorkingDirectory=/home/rav/Development/RAV-SPY
ExecStart=/home/rav/Development/RAV-SPY/deploy/start-bot.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
