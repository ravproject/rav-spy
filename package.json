{
  "name": "@ravproject/rav-spy",
  "version": "2.0.0",
  "description": "Stealth Laptop Intelligence via Telegram/WhatsApp",
  "type": "commonjs",
  "bin": {
    "rav-spy": "run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravproject/rav-spy.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "node run.js",
    "setup": "node setup.js",
    "setup:hub": "node setup.js --hub",
    "setup:agent": "node setup.js --agent",
    "whatsapp": "node run.js --whatsapp",
    "dev": "nodemon --ignore venv/ -e js,json,py,yaml,env run.js",
    "check-deps": "node scripts/check_deps.js",
    "postinstall": "node scripts/check_deps.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "pino": "^9.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
